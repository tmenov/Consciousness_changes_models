## 6. Python-код: воспроизведение ключевых результатов

```python
"""
Модели к патенту US 2026/0039519 A1
Запуск: python3 patent_models_v2.py
Зависимости: numpy, matplotlib
"""
import numpy as np
import matplotlib.pyplot as plt

# ── Константы ─────────────────────────────────────────────────────────────────
C_LIGHT = 3e8          # м/с
F0      = 300e6        # Гц — несущая частота ESA
A       = 0.05         # м  — радиус антенны (5 см)
LAM     = C_LIGHT / F0
K       = 2 * np.pi / LAM
KA      = K * A        # ≈ 0.314

# ── МОДЕЛЬ 1: Предел Чу–Харрингтона ──────────────────────────────────────────
def chu_Q(ka):
    """Q_min(ka) = 1/(ka)³ + 1/(ka)"""
    return 1.0/ka**3 + 1.0/ka

# ── МОДЕЛЬ 2: Кривая компрессии AM-AM (Fig.6 патента) ────────────────────────
def compression_gain(P_in_dBm, P1dB_dBm=-4.0):
    """Saleh-модель: G(P) = G0 / (1 + P/P_sat).  P_sat = 4·P1dB."""
    P_in_W  = 10**(P_in_dBm/10) * 1e-3
    P_sat_W = 4.0 * 10**(P1dB_dBm/10) * 1e-3
    G_lin   = 1.0 / (1.0 + P_in_W / P_sat_W)
    return 10 * np.log10(np.maximum(G_lin, 1e-15))

# ── МОДЕЛЬ 3: LPTV-ёмкости (ур. 6-9 патента, параметры [0044]) ───────────────
def lptv_capacitances(t_array, f_mod=10e6):
    """
    [0044]: a=d=1, c₀=a/2=0.5, c₁=0.9·c₀/2=0.225, Ω=0.95→2π·f_mod
    Возвращает C1, C2, C3, c(t), c1_value
    """
    c0, a, d = 0.5, 1.0, 1.0
    c1 = 0.9 * c0 / 2.0          # = 0.225
    Omega = 2 * np.pi * f_mod
    c_t   = c0 + 2*c1*np.cos(Omega * t_array)
    denom = a*d - c_t**2
    denom = np.where(np.abs(denom) < 1e-9, 1e-9, denom)
    return (2*(a - c_t)/denom,
            2*c_t/denom,
            2*(d - c_t)/denom,
            c_t, c1)

# ── МОДЕЛЬ 4: Анализ устойчивости ────────────────────────────────────────────
def stability_analysis():
    """
    Рабочая точка: c₁=0.45·c₀=0.225
    Критическая:   c₁_кр=0.50·c₀=0.250
    Запас: 10%
    Тепловой дрейф: α_f = 2·10⁻⁴ /°C для медной петлевой антенны
    """
    c0     = 0.5
    c1     = 0.45 * c0   # = 0.225
    c1_cr  = 0.50 * c0   # = 0.250
    margin = (c1_cr - c1) / c1_cr * 100  # 10%

    # Температурный сдвиг эффективного c₁
    alpha_f = 2e-4   # /°C
    dT      = np.linspace(-50, 120, 400)
    c1_eff  = c1 * (1.0 + 3*alpha_f*np.abs(dT))

    dT_crit = dT[c1_eff >= c1_cr]
    T_threshold = dT_crit[0] if len(dT_crit) else None
    return margin, dT, c1_eff/c1_cr*100, T_threshold

# ── МОДЕЛЬ 5: Когнитивный рой ─────────────────────────────────────────────────
def swarm_bandwidth(N_array, BW_single=300e3):
    """
    N пассивных LTI-ESA + копримальный массив:
      BW_virtual = BW_single · √N   (O(N²) степеней свободы)
    Цель: 30 МГц → N = (30e6/300e3)² = 10 000 элементов
    """
    return BW_single * np.sqrt(N_array)

# ── ПОСТРОЕНИЕ ГРАФИКОВ ───────────────────────────────────────────────────────
def plot_all():
    fig = plt.figure(figsize=(16, 10))
    gs  = plt.GridSpec(2, 3, figure=fig, hspace=0.45, wspace=0.38)

    # — Граф 1: Q(ka) ——————————————————————————————————————————
    ax1 = fig.add_subplot(gs[0,0])
    ka_v = np.linspace(0.01, 1.0, 500)
    ax1.semilogy(ka_v, chu_Q(ka_v), 'b-', lw=2, label='Q_min (Чу–Харрингтон)')
    ax1.scatter([KA],  [chu_Q(KA)],  s=100, color='red',
                label=f'Патент: ka={KA:.3f}, Q={chu_Q(KA):.1f}')
    ax1.scatter([0.1], [chu_Q(0.1)], s=80,  color='orange',
                label=f'ka=0.1: Q≈{chu_Q(0.1):.0f}')
    ax1.set_xlabel('ka'); ax1.set_ylabel('Q_min')
    ax1.set_title('Предел Чу–Харрингтона'); ax1.legend(fontsize=7.5)

    # — Граф 2: Кривая компрессии (Fig.6) —————————————————————
    ax2 = fig.add_subplot(gs[0,1])
    P_in = np.linspace(-30, 10, 300)
    ax2.plot(P_in, compression_gain(P_in), 'b-', lw=2, label='Расчёт AM-AM')
    ax2.scatter([-4], [-1], s=120, color='red', zorder=5,
                label='P1dB = −4 дБм (Fig.6)')
    ax2.axhline(-1, color='gray', lw=1, ls='--')
    ax2.axvline(-4, color='red',  lw=1, ls='--')
    ax2.set_xlabel('P_вх (дБм)'); ax2.set_ylabel('ΔG (дБ)')
    ax2.set_title('Компрессия (Fig.6)\nкремний-прототип'); ax2.legend(fontsize=8)

    # — Граф 3: LPTV-ёмкости ——————————————————————————————————
    ax3 = fig.add_subplot(gs[0,2])
    t = np.linspace(0, 3/10e6, 2000)
    C1, C2, C3, c_t, c1 = lptv_capacitances(t)
    t_us = t * 1e6
    ax3.plot(t_us, c_t, 'b-',  lw=2,   label='c(t)')
    ax3.axhline(0.225, color='r',   ls='--', lw=1.5,
                label=f'c₁={c1:.3f} (90% от c₁_кр)')
    ax3.axhline(0.250, color='k',   ls=':',  lw=1.5, label='c₁_кр=0.250')
    ax3.set_xlabel('t (мкс)'); ax3.set_ylabel('c(t)')
    ax3.set_title('Управл. функция c(t)\n[0044]'); ax3.legend(fontsize=7.5)

    # — Граф 4: C₂(t) — ёмкость связи ————————————————————————
    ax4 = fig.add_subplot(gs[1,0])
    ax4.plot(t_us, C1, 'b-',  lw=1.8, label='C₁(t)')
    ax4.plot(t_us, C2, 'r-',  lw=2.0, label='C₂(t) — связь')
    ax4.plot(t_us, C3, 'g--', lw=1.8, label='C₃(t)')
    ax4.set_xlabel('t (мкс)'); ax4.set_ylabel('Норм. ёмкость')
    ax4.set_title('LPTV-ёмкости C₁,C₂,C₃\nур. 6-8 патента'); ax4.legend(fontsize=7.5)

    # — Граф 5: Устойчивость ——————————————————————————————————
    ax5 = fig.add_subplot(gs[1,1])
    margin, dT, frac, T_thr = stability_analysis()
    ax5.plot(dT, frac, 'b-', lw=2)
    ax5.axhline(100, color='red', lw=2, ls='--', label='100% = срыв')
    if T_thr:
        ax5.axvline(T_thr, color='r', lw=1.5, ls=':',
                    label=f'ΔT_кр ≈ {T_thr:.0f}°C')
        ax5.fill_between(dT, frac, 100,
                         where=(np.array(frac) >= 100),
                         alpha=0.25, color='red')
    ax5.set_xlabel('ΔT (°C)'); ax5.set_ylabel('c₁/c₁_кр × 100%')
    ax5.set_title(f'Тепловая устойчивость\nзапас={margin:.0f}% (!)')
    ax5.legend(fontsize=8); ax5.set_ylim(80, 115)

    # — Граф 6: Рой ———————————————————————————————————————————
    ax6 = fig.add_subplot(gs[1,2])
    N_v = np.logspace(0, 4.5, 300)
    BW_v = swarm_bandwidth(N_v) / 1e6
    ax6.loglog(N_v, BW_v, color='purple', lw=2.5, label='BW = √N · 300 кГц')
    ax6.axhline(30,  color='red',  lw=2,   ls='--', label='Цель: 30 МГц')
    ax6.axhline(0.3, color='gray', lw=1.5, ls=':',  label='BW_one = 300 кГц')
    ax6.axvline(1e4, color='orange', lw=1.5, ls='-.', label='N=10 000')
    ax6.set_xlabel('Число элементов N')
    ax6.set_ylabel('BW_virtual (МГц)')
    ax6.set_title('Концепт В: Когнитивный рой\nBW(N) = √N · BW_single')
    ax6.legend(fontsize=7.5)

    fig.suptitle('Физические модели к патенту US 2026/0039519 A1\n'
                 '"Multi-Tone Modulated Antenna" — RTX BBN / CUNY / Wayne State',
                 fontsize=13, fontweight='bold')
    plt.savefig('patent_analysis.png', bbox_inches='tight', dpi=150)
    plt.show()
    print(f"\nРезультаты:\n  ka={KA:.4f}, Q_min={chu_Q(KA):.1f}")
    print(f"  BW_пасс={F0/chu_Q(KA)/1e6:.2f} МГц, BW_цель=30 МГц")
    print(f"  c₁=0.225 (90% от c₁_крит=0.250) → запас 10%")
    print(f"  Рой N=10000 → BW_virtual={swarm_bandwidth(10000)/1e6:.1f} МГц")

if __name__ == '__main__':
    plot_all()
```

